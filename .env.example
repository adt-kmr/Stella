# ------------------------------------------------------------------
# STELLA configuration
# Copy to `.env` and adjust. All variables are read by api/config.py
# (prefix STELLA_). The frontend uses frontend/.env for VITE_ vars.
# ------------------------------------------------------------------

# --- runtime ---
STELLA_APP_NAME=STELLA
STELLA_DEBUG=false
STELLA_DATA_ROOT=data
STELLA_MODELS_ROOT=models
STELLA_NOWCASTER_CKPT=models/nowcaster.pt
STELLA_FORECASTER_CKPT=models/forecaster.pt

# --- inference behaviour ---
STELLA_ALERT_LEAD_MIN=30
STELLA_FLARE_THRESHOLD_CLASS=M1.0
STELLA_CASCADE_MIN_CONFIDENCE=0.5