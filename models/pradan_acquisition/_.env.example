# Copy to .env (never commit .env). Only the variables for YOUR auth.mode are needed.
# auth.mode = form_login or basic  (PRADAN account you registered at https://pradan.issdc.gov.in/al1/)
PRADAN_USERNAME=
PRADAN_PASSWORD=
# auth.mode = bearer (only if PRADAN/ISSDC has issued you an API token; none is documented publicly)
PRADAN_TOKEN=
